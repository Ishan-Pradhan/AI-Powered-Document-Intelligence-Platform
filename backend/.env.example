PORT=8080
NODE_ENV=production

# -------------------------------------------------------------
# Database Setup
# -------------------------------------------------------------
# Neon DB (Recommended for production):
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Or standard local PostgreSQL credentials:
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=document_intelligence
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false

# -------------------------------------------------------------
# JWT Authentication Secrets (min 32 chars)
# -------------------------------------------------------------
ACCESS_TOKEN_SECRET=your_super_secret_access_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# -------------------------------------------------------------
# Email Configuration (Resend or SMTP)
# -------------------------------------------------------------
# Option 1: Resend (Recommended for custom domain):
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="DocIntel <noreply@yourdomain.com>"

# Option 2: Traditional SMTP (e.g. Gmail):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_specific_password

# -------------------------------------------------------------
# OAuth Providers (Optional)
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/v1/auth/oauth/github/callback

# -------------------------------------------------------------
# LLM Providers (Groq & Gemini)
# -------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# Use llama-3.1-8b-instant for much higher free rate limits (30k TPM / 14.4k RPD):
CHAT_MODEL=llama-3.1-8b-instant

# Gemini key for vector embeddings:
GOOGLE_API_KEY=AQ.your_gemini_api_key_here

# -------------------------------------------------------------
# URLs & Cross-Origin Configuration
# -------------------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com
SSO_SHARED_SECRET=your_sso_shared_secret_string

# -------------------------------------------------------------
# AI Chat Quota & Rate Limiting
# -------------------------------------------------------------
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=10
